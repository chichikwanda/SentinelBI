# Copy to .env (`make up` does this for you). Values prefixed "dev-only" are refused when ENV=prod.

ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO

# --- Postgres / TimescaleDB (use URL-safe characters: the password is embedded in a URL) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=sentinelbi

# --- Auth ---
# Generate for real deployments: openssl rand -hex 32
SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=60
ALLOW_REGISTRATION=true       # open org sign-up; set false on a public deployment
PLATFORM_ADMIN_EMAILS=admin@demo.sentinelbi.example   # may switch the platform-wide model (dev default)

# --- What the onboarding wizard tells routers to export to ---
COLLECTOR_PUBLIC_HOST=localhost
COLLECTOR_PUBLIC_PORT=2055
API_PUBLIC_URL=http://localhost:8000

# --- Privacy ---
PSEUDONYMIZE_IPS=false        # HMAC-pseudonymise private/internal IPs before storage
PSEUDONYM_KEY=dev-only-pseudonym-key

# --- Demo data (dev only; refused in prod) ---
SEED_DEMO_DATA=true
DEMO_PASSWORD=dev-only-demo-password
DEMO_API_KEY=sbi_demo_dev_only_api_key_0000000000000000

# --- Published host ports ---
API_PORT=8000
WEB_PORT=3000
